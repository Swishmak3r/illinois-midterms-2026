{
  "name": "illinois-midterms-2026",
  "version": "1.0.0",
  "private": true,
  "description": "Static Illinois election research guide and browser regression checks",
  "scripts": {
    "test": "node scripts/browser-checks.cjs",
    "test:data": "node scripts/browser-checks.cjs --data-only --output output/playwright/data",
    "test:chromium": "node scripts/browser-checks.cjs --engines chromium",
    "test:browsers": "node scripts/browser-checks.cjs --engines chromium,firefox,webkit",
    "browsers:install": "node scripts/browser-checks.cjs --install",
    "capture:before": "node scripts/browser-checks.cjs --capture --url https://swishmak3r.github.io/illinois-midterms-2026/?zip=60647 --output output/playwright/before",
    "dev": "node scripts/serve.cjs",
    "build": "python build.py",
    "test:finance": "python scripts/test_fec_sync.py && node scripts/test-fec-api.mjs",
    "test:evidence": "node scripts/check-evidence.cjs",
    "test:alignment": "node scripts/test-alignment.cjs",
    "test:audit-ui": "node scripts/check-audit-ui.cjs",
    "test:accuracy-ui": "node scripts/check-accuracy-ui.cjs",
    "test:judicial": "python scripts/build-judicial-research.py --check && node scripts/check-judicial-research.cjs",
    "test:judicial-ui": "node scripts/check-judicial-ui.cjs",
    "test:rosters": "node scripts/2026-11-01-roster-check.cjs && node audit/2026-11-01-roster-federal-statewide-test.cjs && node audit/2026-11-01-local-check.cjs && node audit/2026-11-01-gap-check.cjs",
    "test:geography": "node scripts/test-geography-audit.cjs",
    "test:content": "node audit/2026-11-01-content-verify.cjs",
    "verify": "npm run test:rosters && npm run test:geography && npm run test:evidence && npm run test:content && npm run test:judicial && npm run test:alignment && npm run test:finance && npm run build"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=20"
  }
}
